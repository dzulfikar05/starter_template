{
    "name": "starter-template",
    "description": "Starter Template — Next.js + NestJS + Auth.js + Prisma monorepo",
    "license": "MIT",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types",
        "build:backend": "turbo run build --filter=@starter-template/backend",
        "start:backend": "turbo run start --filter=@starter-template/database --filter=@starter-template/backend",
        "db:migrate": "cd packages/database && bun run db:migrate",
        "db:migrate:deploy": "cd packages/database && bun run db:migrate:deploy",
        "db:seed": "cd packages/database && bun run db:seed",
        "db:studio": "cd packages/database && bun run dev"
    },
    "devDependencies": {
        "prettier": "^3.7.4",
        "turbo": "^2.9.14",
        "typescript": "5.9.2"
    },
    "packageManager": "bun@1.3.8",
    "engines": {
        "node": ">=20.19"
    }
}
